# CampuGrid Reverse Proxy

:80 {
    # Marketing / Consumer Web App (Next.js)
    handle /api/v1/* {
        reverse_proxy localhost:8000
    }

    handle /ws/* {
        reverse_proxy localhost:8000
    }

    handle /docs* {
        reverse_proxy localhost:8000
    }

    handle /redoc* {
        reverse_proxy localhost:8000
    }

    handle /health {
        reverse_proxy localhost:8000
    }

    handle /metrics {
        reverse_proxy localhost:8000
    }

    # MinIO Console (dev only)
    handle /minio/* {
        reverse_proxy localhost:9001
    }

    # Everything else → Next.js
    handle {
        reverse_proxy localhost:3000
    }
}

# Public S3 API endpoint — contributor nodes and customer browsers fetch job
# inputs / push outputs here via presigned URLs. The host MUST match the host
# configured in PUBLIC_MINIO_ENDPOINT, because SigV4 signs the Host header.
# Point a DNS record for s3.campusgrid.sahuja.in at this machine.
s3.campusgrid.sahuja.in {
    reverse_proxy localhost:9000
}
