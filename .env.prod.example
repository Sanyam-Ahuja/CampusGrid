# ==============================================================================
# CampusGrid Production Environment Configuration
# Save this file as '.env' in your virtual machine's project root directory.
# ==============================================================================

# --- PostgreSQL Settings ---
POSTGRES_USER=campugrid
POSTGRES_PASSWORD=use-a-secure-random-postgres-password
POSTGRES_DB=campugrid

# --- MinIO (S3 Object Storage) Credentials ---
MINIO_ACCESS_KEY=campugrid
MINIO_SECRET_KEY=use-a-secure-random-minio-secret-key

# --- JWT Authentication Settings ---
# Generate a secure key on your VM using: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Gemini API (For AI pipeline task verification & generation) ---
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key

# --- OAuth Configuration (Google Sign-In) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Monitoring Dashboards ---
# Password for Grafana dashboard admin user
GRAFANA_PASSWORD=your-secure-grafana-admin-password
